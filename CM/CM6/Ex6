class Voiture:
    def __init__(self, couleur = None, nationalite = None, marque = None):
        self.couleur = couleur
        self._nationalite = nationalite
        self.__marque = marque
    
    @classmethod
    def afficher_couleur(cls):
        print(f"Couleur: {Voiture.couleur}")
    
    @classmethod
    def afficher_nationalite(cls):
        print(f"Nationalité: {Voiture._nationalite}")
    
    @classmethod
    def afficher_marque(cls):
        print(f"Marque: {Voiture.__marque}")

    @classmethod
    def modifier_marque(cls, nouvelle_marque):
        Voiture.__marque = nouvelle_marque
    
Voiture1 = Voiture("Rouge", "DE", "BMW")
Voiture1.modifier_marque("Audi")

Voiture1.afficher_couleur
Voiture1.afficher_nationalite
Voiture1.afficher_marque