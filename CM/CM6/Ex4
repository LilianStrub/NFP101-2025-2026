class Voiture:
    def __init__(self, couleur = None, nationalite = None, marque = None):
        self.couleur = couleur
        self._nationalite = nationalite
        self.__marque = marque
    
    def afficher_couleur(self):
        print(f"Couleur: {self.couleur}")
    
    def afficher_nationalite(self):
        print(f"Nationalité: {self._nationalite}")
    
    def afficher_marque(self):
        print(f"Marque: {self.__marque}")
        
    def modifier_marque(self, nouvelle_marque):
        self.__marque = nouvelle_marque
        
Voiture1 = Voiture("Rouge", "DE", "BMW")
Voiture1.modifier_marque("Audi")

Voiture1.afficher_couleur()
Voiture1.afficher_nationalite()
Voiture1.afficher_marque()